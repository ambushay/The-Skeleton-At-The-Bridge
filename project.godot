; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dialogic test"
run/main_scene="uid://bgxu1cxcomjmf"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://Assets/Portrait/icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"Enemy12": "res://Assets/Characters/Enemy12.dch",
"Player": "res://Assets/Characters/Player.dch"
}
